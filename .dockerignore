# Dependencies (reinstalled inside container)
node_modules
.yarn/cache
.yarn/install-state.gz

# Build outputs (rebuilt inside container)
**/dist
**/out
**/.next

# Git history (not needed for build)
.git
.gitmodules

# Desktop/mobile apps - exclude src but keep package.json for workspace resolution
packages/frontend/apps/electron/src
packages/frontend/apps/electron/resources
packages/frontend/apps/electron/scripts
packages/frontend/apps/electron-renderer/src
packages/frontend/apps/ios
packages/frontend/apps/android
packages/frontend/apps/mobile/src

# BlockSuite heavy directories (keep package.json files)
blocksuite/node_modules
blocksuite/**/dist
blocksuite/**/out
blocksuite/playground
blocksuite/examples

# Tests and dev tools
**/__tests__
**/*.test.*
**/*.spec.*
**/*.e2e.*
.devcontainer
tests
e2e

# CI/CD (not needed in build)
.github

# Large binary assets
**/*.mp4
**/*.gif
**/screenshots

# Cache and temp files
.cache
.turbo
.parcel-cache
*.log
*.tsbuildinfo

# IDE and editor files
.idea
.vscode
*.swp
*.swo

# Claude and other tools
.claude
nul
